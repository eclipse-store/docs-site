# Auto detect text files and perform LF normalization
* text=auto eol=lf

# The generated site under docs/ carries fonts and images. Be explicit so no
# platform ever tries to normalise them.
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
